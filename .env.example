# Public canonical origin for local production builds.
VITE_SITE_URL=https://homemarbletemple.com
# Set to /api/enquiry in Vercel to proxy submissions to the existing Netlify form.
# Leave unset on Netlify to keep its existing POST / behavior.
VITE_ENQUIRY_SUBMISSION_URL=

# Server-only settings for the product enquiry assistant (Vercel and existing Netlify deployment).
# Configure production values in the hosting provider's server environment. Never use a VITE_ prefix for secrets.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
NVIDIA_NIM_ENABLED=false
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Server-only Netlify function configuration. Add values in Netlify's environment settings.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SPREADSHEET_ID=
GOOGLE_SHEET_TAB=Lead Register
GOOGLE_CONTROL_TAB=Report Control
# Private tab for 3D Studio sign-ups and quotation requests. See STUDIO_LEADS_SETUP.md.
GOOGLE_STUDIO_LEADS_TAB=Studio Leads
# Vercel Studio lead adapter keeps using the existing Netlify Identity and Blobs services.
# Configure server-only values in Vercel; never expose NETLIFY_BLOBS_TOKEN to the browser.
NETLIFY_BLOBS_SITE_ID=
NETLIFY_BLOBS_TOKEN=
NETLIFY_IDENTITY_URL=https://singular-kelpie-c8df6b.netlify.app/.netlify/identity
NETLIFY_ACCESS_TOKEN=
NETLIFY_FORM_ID=
NETLIFY_SYNC_MAX_PAGES=100
RESEND_API_KEY=
REPORT_FROM_EMAIL=
REPORT_TO_EMAIL=
CUSTOMER_ACK_FROM_EMAIL=
REPORT_TIMEZONE=Asia/Kolkata
LEAD_OWNER_NAME=
LEAD_BACKUP_OWNER_NAME=
LEAD_OWNER_OPTIONS=
LEAD_BACKUP_OWNER_OPTIONS=
