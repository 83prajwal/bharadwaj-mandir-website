# Public canonical origin for local production builds.
VITE_SITE_URL=https://homemarbletemple.com

# Server-only settings for the product enquiry assistant (Vercel and existing Netlify deployment).
# Configure production values in the hosting provider's server environment. Never use a VITE_ prefix for secrets.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
NVIDIA_NIM_ENABLED=false
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Existing Netlify Google Sheets configuration, retained for the Netlify rollback path.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SPREADSHEET_ID=
GOOGLE_SHEET_TAB=Lead Register
GOOGLE_CONTROL_TAB=Report Control
# Private tab for 3D Studio sign-ups and quotation requests. See STUDIO_LEADS_SETUP.md.
GOOGLE_STUDIO_LEADS_TAB=Studio Leads
# Vercel Studio Lead adapter uses the existing Netlify Identity and Blobs services.
# Configure these as server-only Vercel variables; never use a VITE_ prefix for tokens.
NETLIFY_BLOBS_SITE_ID=
NETLIFY_BLOBS_TOKEN=
NETLIFY_IDENTITY_URL=https://singular-kelpie-c8df6b.netlify.app/.netlify/identity
# Supabase customer-profile access for the server-side Studio Lead adapter.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Vercel Studio Lead -> existing Apps Script Web App. Configure only server-side in Vercel.
STUDIO_LEAD_APPS_SCRIPT_URL=
STUDIO_LEAD_APPS_SCRIPT_SECRET=
NETLIFY_ACCESS_TOKEN=
NETLIFY_FORM_ID=
NETLIFY_SYNC_MAX_PAGES=100
RESEND_API_KEY=
REPORT_FROM_EMAIL=
REPORT_TO_EMAIL=
CUSTOMER_ACK_FROM_EMAIL=
REPORT_TIMEZONE=Asia/Kolkata
LEAD_OWNER_NAME=
LEAD_BACKUP_OWNER_NAME=
LEAD_OWNER_OPTIONS=
LEAD_BACKUP_OWNER_OPTIONS=
